{
  "id": "tioanime",
  "name": "TioAnime",
  "version": "1.9.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Anime subtitulado en español de TioAnime, con todos los servidores de video compatibles (Voe, YourUpload, Okru, Mp4Upload, StreamWish, FileMoon, VidHide y Mixdrop).",
  "author": "tu-usuario-de-github",
  "hosts": [
    "tioanime.com",
    "*.tioanime.com"
  ],
  "fetchHosts": "any",
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
  ],
  "categories": [
    "anime"
  ],
  "discoverable": true,
  "debug": false,
  "color": "#263DFF",
  "settings": [
    {
      "key": "server",
      "label": "Servidor preferido",
      "type": "select",
      "default": "voe",
      "hint": "Los demás servidores del capítulo quedan en el menú Servidor del reproductor.",
      "options": [
        {
          "value": "voe",
          "label": "Voe"
        },
        {
          "value": "yourupload",
          "label": "YourUpload"
        },
        {
          "value": "okru",
          "label": "Okru"
        },
        {
          "value": "mp4upload",
          "label": "Mp4Upload"
        },
        {
          "value": "streamwish",
          "label": "StreamWish"
        },
        {
          "value": "filemoon",
          "label": "FileMoon"
        },
        {
          "value": "vidhide",
          "label": "VidHide"
        },
        {
          "value": "mixdrop",
          "label": "Mixdrop"
        }
      ]
    }
  ]
}
